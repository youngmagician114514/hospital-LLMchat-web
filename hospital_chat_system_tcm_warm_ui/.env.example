MODEL_PROVIDER=openai_compat
# MODEL_PROVIDER=stub
# MODEL_PROVIDER=vllm_openai

# ChatECNU (OpenAI-compatible mode)
OPENAI_API_BASE=https://chat.ecnu.edu.cn/open/api/v1
OPENAI_API_KEY=your-chatecnu-api-key
OPENAI_MODEL=ecnu-max

# vLLM decoupled model service (optional)
VLLM_API_BASE=http://127.0.0.1:8001/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=qwen2.5-7b-instruct

# Shared generation params for OpenAI-compatible providers
GENERATION_TEMPERATURE=0.2
GENERATION_TOP_P=0.9
GENERATION_MAX_TOKENS=1536
# Total output budget when thinking is enabled (reasoning + final answer).
THINKING_MAX_TOKENS=8192

# Runtime config
REQUEST_TIMEOUT_SECONDS=300
MAX_CONCURRENT_MODEL_CALLS=3
MAX_HISTORY_MESSAGES=20
SESSION_TTL_SECONDS=3600
SESSION_CLEANUP_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
